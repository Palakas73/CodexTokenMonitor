<Window x:Class="CodexTokenMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CodexTokenMonitor.App.Controls"
        Title="Codex Token Monitor" Icon="Assets/CodexTokenMonitor.ico" Width="340" Height="300" MinWidth="260" MinHeight="220" Topmost="True" ShowActivated="False" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" Background="Transparent" Foreground="#F1F5F9" MouseLeftButtonDown="DragWidget">
    <Border x:Name="Surface" Background="#F2151B25" CornerRadius="16" BorderBrush="#40546A" BorderThickness="1">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="CODEX · REMAINING QUOTA" FontSize="14" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FACC15" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding ResetCoinSlots}" Margin="8,0,0,0" ToolTip="{Binding ResetCoinsHint}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Image Source="/CodexTokenMonitor.App;component/Assets/MONEDA.png" Width="18" Height="18" Margin="1,0" /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding LastUpdate}" Margin="0,10" />
            <Button Content="Refresh" Click="RefreshClick" Padding="12,6" HorizontalAlignment="Left" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Margin="0,6"><TextBlock Text="{Binding Label}" /><controls:QuotaPresenter Height="88" Mode="{Binding DataContext.Mode, RelativeSource={RelativeSource AncestorType=Window}}" Remaining="{Binding Remaining}" ToolTip="{Binding Percentage}" /><TextBlock Text="{Binding Reset}" FontSize="11" Foreground="#CBD5E1" /></StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </DockPanel>
    </Border>
</Window>
